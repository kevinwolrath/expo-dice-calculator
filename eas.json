{
  "cli": {
    "version": ">= 21.7.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "testing": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {}
  },
  "submit": {
    "testing": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "production": {}
  }
}
